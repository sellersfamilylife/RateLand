# Supabase — use the ANON (public) key, NEVER the service role key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API keys for Census, FBI, and HUD are now stored as Supabase Secrets
# (server-side only). See SETUP.md § "Deploy the Edge Function" for details.
# They are NOT needed in client .env anymore.
